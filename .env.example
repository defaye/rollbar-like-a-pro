# Rollbar Configuration
# This is the CLIENT-SIDE access token (safe to include in browser bundles)
# Get this from: https://app.rollbar.com/settings/access_tokens/
VITE_ROLLBAR_ACCESS_TOKEN=your_client_side_access_token_here

# Development Mode
# Set to 'true' to enable dev panel for triggering test errors
VITE_DEV_MODE=false

# Playwright Testing Configuration (NOT prefixed with VITE_ - only for Node.js tests)
# These are NOT bundled into the extension
ROLLBAR_ACCOUNT_SLUG=your_account_slug

# For GitHub OAuth, use authenticated storage state
# See: https://playwright.dev/docs/auth
